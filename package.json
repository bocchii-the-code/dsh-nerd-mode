{
  "name": "dsh-nerd-mode",
  "version": "0.2.1",
  "description": "A study switch and study skills for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bocchii-the-code/dsh-nerd-mode.git"
  },
  "homepage": "https://github.com/bocchii-the-code/dsh-nerd-mode#readme",
  "bugs": {
    "url": "https://github.com/bocchii-the-code/dsh-nerd-mode/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "README.zh.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "study",
    "tutor",
    "agent-skill"
  ],
  "publishConfig": {
    "access": "public"
  }
}
